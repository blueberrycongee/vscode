{
  "name": "wuu",
  "publisher": "vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "10.0.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.5.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onView:wuu.tasks",
    "onCommand:wuu.createTask",
    "onCommand:wuu.createSession",
    "onCommand:wuu.refreshTasks",
    "onCommand:wuu.openTask",
    "onCommand:wuu.removeTask",
    "onCommand:wuu.startSession",
    "onCommand:wuu.stopSession",
    "onCommand:wuu.openSessionTerminal",
    "onCommand:wuu.removeSession",
    "onCommand:wuu.exportTaskPatch",
    "onCommand:wuu.previewPatch",
    "onCommand:wuu.applyPatch",
    "onCommand:wuu.requeuePatch",
    "onCommand:wuu.markPatchApplied",
    "onCommand:wuu.removePatch",
    "onCommand:wuu.focusPatchInbox",
    "onCommand:wuu.openSessionTerminalEditor",
    "onCommand:wuu.quickReplySession",
    "onCommand:wuu.openDashboard"
  ],
  "main": "./out/extension",
  "scripts": {
    "compile": "gulp compile-extension:wuu",
    "watch": "gulp watch-extension:wuu"
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "wuu",
          "title": "%viewContainer.wuu.title%",
          "icon": "media/wuu.svg"
        }
      ]
    },
    "views": {
      "wuu": [
        {
          "id": "wuu.tasks",
          "name": "%view.tasks.name%"
        },
        {
          "id": "wuu.patches",
          "name": "%view.patches.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "wuu.tasks",
        "contents": "%view.tasks.welcome%"
      },
      {
        "view": "wuu.patches",
        "contents": "%view.patches.welcome%"
      }
    ],
    "commands": [
      {
        "command": "wuu.createTask",
        "category": "%command.category%",
        "title": "%command.createTask%",
        "icon": "$(add)"
      },
      {
        "command": "wuu.refreshTasks",
        "category": "%command.category%",
        "title": "%command.refreshTasks%",
        "icon": "$(refresh)"
      },
      {
        "command": "wuu.openTask",
        "category": "%command.category%",
        "title": "%command.openTask%"
      },
      {
        "command": "wuu.removeTask",
        "category": "%command.category%",
        "title": "%command.removeTask%"
      },
      {
        "command": "wuu.createSession",
        "category": "%command.category%",
        "title": "%command.createSession%",
        "icon": "$(add)"
      },
      {
        "command": "wuu.startSession",
        "category": "%command.category%",
        "title": "%command.startSession%",
        "icon": "$(play)"
      },
      {
        "command": "wuu.stopSession",
        "category": "%command.category%",
        "title": "%command.stopSession%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "wuu.openSessionTerminal",
        "category": "%command.category%",
        "title": "%command.openSessionTerminal%"
      },
      {
        "command": "wuu.openSessionTerminalEditor",
        "category": "%command.category%",
        "title": "%command.openSessionTerminalEditor%"
      },
      {
        "command": "wuu.quickReplySession",
        "category": "%command.category%",
        "title": "%command.quickReplySession%"
      },
      {
        "command": "wuu.removeSession",
        "category": "%command.category%",
        "title": "%command.removeSession%"
      },
      {
        "command": "wuu.exportTaskPatch",
        "category": "%command.category%",
        "title": "%command.exportTaskPatch%"
      },
      {
        "command": "wuu.previewPatch",
        "category": "%command.category%",
        "title": "%command.previewPatch%"
      },
      {
        "command": "wuu.applyPatch",
        "category": "%command.category%",
        "title": "%command.applyPatch%"
      },
      {
        "command": "wuu.requeuePatch",
        "category": "%command.category%",
        "title": "%command.requeuePatch%"
      },
      {
        "command": "wuu.markPatchApplied",
        "category": "%command.category%",
        "title": "%command.markPatchApplied%"
      },
      {
        "command": "wuu.removePatch",
        "category": "%command.category%",
        "title": "%command.removePatch%"
      },
      {
        "command": "wuu.focusPatchInbox",
        "category": "%command.category%",
        "title": "%command.focusPatchInbox%"
      },
      {
        "command": "wuu.openDashboard",
        "category": "%command.category%",
        "title": "%command.openDashboard%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "wuu.createTask",
          "when": "view == wuu.tasks",
          "group": "navigation"
        },
        {
          "command": "wuu.refreshTasks",
          "when": "view == wuu.tasks",
          "group": "navigation@1"
        },
        {
          "command": "wuu.createSession",
          "when": "view == wuu.tasks",
          "group": "navigation@2"
        },
        {
          "command": "wuu.previewPatch",
          "when": "view == wuu.tasks",
          "group": "navigation@3"
        },
        {
          "command": "wuu.applyPatch",
          "when": "view == wuu.tasks",
          "group": "navigation@4"
        },
        {
          "command": "wuu.refreshTasks",
          "when": "view == wuu.patches",
          "group": "navigation"
        },
        {
          "command": "wuu.openDashboard",
          "when": "view == wuu.tasks || view == wuu.patches",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "wuu.openTask",
          "when": "view == wuu.tasks && viewItem == wuuTask",
          "group": "navigation"
        },
        {
          "command": "wuu.removeTask",
          "when": "view == wuu.tasks && viewItem == wuuTask",
          "group": "inline"
        },
        {
          "command": "wuu.createSession",
          "when": "view == wuu.tasks && viewItem == wuuTask",
          "group": "navigation@1"
        },
        {
          "command": "wuu.exportTaskPatch",
          "when": "view == wuu.tasks && viewItem == wuuTask",
          "group": "navigation@2"
        },
        {
          "command": "wuu.previewPatch",
          "when": "view == wuu.tasks && viewItem == wuuTask",
          "group": "navigation@3"
        },
        {
          "command": "wuu.applyPatch",
          "when": "view == wuu.tasks && viewItem == wuuTask",
          "group": "navigation@4"
        },
        {
          "command": "wuu.openSessionTerminalEditor",
          "when": "view == wuu.tasks && viewItem == wuuSessionRunning",
          "group": "navigation"
        },
        {
          "command": "wuu.openSessionTerminalEditor",
          "when": "view == wuu.tasks && (viewItem == wuuSessionIdle || viewItem == wuuSessionRetry)",
          "group": "navigation"
        },
        {
          "command": "wuu.stopSession",
          "when": "view == wuu.tasks && viewItem == wuuSessionRunning",
          "group": "inline"
        },
        {
          "command": "wuu.startSession",
          "when": "view == wuu.tasks && viewItem == wuuSessionIdle",
          "group": "inline"
        },
        {
          "command": "wuu.startSession",
          "when": "view == wuu.tasks && viewItem == wuuSessionRetry",
          "group": "inline"
        },
        {
          "command": "wuu.quickReplySession",
          "when": "view == wuu.tasks && (viewItem == wuuSessionRunning || viewItem == wuuSessionIdle || viewItem == wuuSessionRetry)",
          "group": "navigation@8"
        },
        {
          "command": "wuu.removeSession",
          "when": "view == wuu.tasks && (viewItem == wuuSessionRunning || viewItem == wuuSessionIdle || viewItem == wuuSessionRetry)",
          "group": "navigation@9"
        },
        {
          "command": "wuu.previewPatch",
          "when": "view == wuu.patches && (viewItem == wuuPatchPending || viewItem == wuuPatchConflict || viewItem == wuuPatchApplied)",
          "group": "navigation"
        },
        {
          "command": "wuu.applyPatch",
          "when": "view == wuu.patches && (viewItem == wuuPatchPending || viewItem == wuuPatchConflict)",
          "group": "inline"
        },
        {
          "command": "wuu.markPatchApplied",
          "when": "view == wuu.patches && (viewItem == wuuPatchPending || viewItem == wuuPatchConflict)",
          "group": "navigation@1"
        },
        {
          "command": "wuu.requeuePatch",
          "when": "view == wuu.patches && (viewItem == wuuPatchConflict || viewItem == wuuPatchApplied)",
          "group": "navigation@2"
        },
        {
          "command": "wuu.removePatch",
          "when": "view == wuu.patches && (viewItem == wuuPatchPending || viewItem == wuuPatchConflict || viewItem == wuuPatchApplied || viewItem == wuuPatchUnsupported)",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "Wuu",
      "properties": {
        "wuu.worktreesRoot": {
          "type": "string",
          "scope": "resource",
          "default": "${workspaceFolder}/.wuu/worktrees",
          "markdownDescription": "%config.worktreesRoot%"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
